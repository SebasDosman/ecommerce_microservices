# Environment variables for Product Service
MONGO_HOST=<mongo_host>
MONGO_PORT=<mongo_port>
MONGO_DATABASE=<mongo_database>
MONGO_USERNAME=<mongo_username>
MONGO_PASSWORD=<mongo_password>
MONGO_AUTH_DB=<mongo_auth_db>
PRODUCT_SERVER_PORT=<product_server_port>

# Environment variables for Order Service
POSTGRES_HOST=<postgres_host>
POSTGRES_PORT=<postgres_port>
POSTGRES_DB=<postgres_db>
POSTGRES_USER=<postgres_user>
POSTGRES_PASSWORD=<postgres_password>
ORDER_SERVER_PORT=<order_server_port>

# Environment variables for Inventory Service
MYSQL_HOST=<mysql_host>
MYSQL_PORT=<mysql_port>
MYSQL_DATABASE=<mysql_database>
MYSQL_ROOT_USERNAME=<mysql_root_username>
MYSQL_ROOT_PASSWORD=<mysql_root_password>
INVENTORY_SERVER_PORT=<inventory_server_port>

# Environment variables for Keycloak Service
POSTGRES_KEYCLOAK_DB=<postgres_keycloak_db>
POSTGRES_KEYCLOAK_USER=<postgres_keycloak_user>
POSTGRES_KEYCLOAK_PASSWORD=<postgres_keycloak_password>
KEYCLOAK_ADMIN_USERNAME=<keycloak_admin_username>
KEYCLOAK_ADMIN_PASSWORD=<keycloak_admin_password>

# Environment variables for RabbitMQ Service
RABBITMQ_DEFAULT_USER=<rabbitmq_default_user>
RABBITMQ_DEFAULT_PASS=<rabbitmq_default_pass>

# MailTrap SMTP configuration
MAILTRAP_HOST=<mailtrap_host>
MAILTRAP_PORT=<mailtrap_port>
MAILTRAP_USERNAME=<mailtrap_username>
MAILTRAP_PASSWORD=<mailtrap_password>